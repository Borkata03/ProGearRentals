@using Microsoft.AspNetCore.Identity
@using ProGearRentals.Infrastructure.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager




<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{

        var currentUser = await UserManager.FindByIdAsync(User.Id());
        var userName = $"{currentUser.FirstName} {currentUser.LastName}";
        <li class="nav-item">
            <a class="nav-link text-white"  title ="Manage">Hello @userName!   </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-area=""  asp-controller="Home" asp-action="Index" title="Public Interface">Public Interface</a>
        </li>



    }
else
{
    <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
